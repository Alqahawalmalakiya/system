{
  "topLevelName": "royal-coffee",
  "definedEnvironments": [],
  "legacy_env": true,
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "jsx_factory": "React.createElement",
  "jsx_fragment": "React.Fragment",
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "name": "royal-coffee",
  "main": "index.js",
  "triggers": {},
  "assets": {
    "binding": "ASSETS",
    "directory": "../client"
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ALLOWED_EMAILS": ""
  },
  "durable_objects": {
    "bindings": []
  },
  "workflows": [],
  "migrations": [],
  "kv_namespaces": [],
  "cloudchamber": {},
  "send_email": [],
  "queues": {
    "producers": [],
    "consumers": []
  },
  "r2_buckets": [],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "royal-coffee-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "vectorize": [],
  "ai_search_namespaces": [],
  "ai_search": [],
  "hyperdrive": [],
  "services": [],
  "analytics_engine_datasets": [],
  "dispatch_namespaces": [],
  "mtls_certificates": [],
  "pipelines": [],
  "secrets_store_secrets": [],
  "artifacts": [],
  "unsafe_hello_world": [],
  "flagship": [],
  "worker_loaders": [],
  "ratelimits": [],
  "vpc_services": [],
  "vpc_networks": [],
  "logfwdr": {
    "bindings": []
  },
  "python_modules": {
    "exclude": [
      "**/*.pyc"
    ]
  },
  "dev": {
    "ip": "localhost",
    "local_protocol": "http",
    "upstream_protocol": "http",
    "enable_containers": true,
    "generate_types": false
  },
  "no_bundle": true
}